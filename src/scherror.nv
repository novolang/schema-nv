// scherror.nv — the one fault type, and the place in the schema it
// happened.
//
// A fault is about the schema; a failure is about the instance.
// `schcompile.compile` answers `Result<SchSchema, SchFault>`: a schema
// that is not a schema, such as `"type": 3` or a `$ref` to a document
// nobody registered, is a fault, once, at compile time.
// `schvalidate.validate` answers a `SchOutput` and never a `Result`,
// because an instance that does not match is the answer, with its
// reasons.
//
// A fault's position is an RFC 6901 JSON Pointer into the schema
// document, not a byte offset.  A schema arrives as a parsed value, so
// there is no source text left to point into, and `/properties/age/type`
// is a location a reader can paste into another implementation.

// What was wrong with the schema, named.
//
// ```novo
// use scherror
//
// fn main() [io]
//     println(scherror.kind_name(SchUnresolvedRef))
// ```
pub enum SchFaultKind
    // A schema that is neither an object nor a boolean.  `true` and
    // `false` are schemas in 2020-12, matching everything and nothing,
    // and anything else is not.
    SchNotASchema
    // A keyword whose value is the wrong shape: `"type": 3`,
    // `"required": "name"`, `"properties": []`.
    SchBadKeywordValue
    // A `type` naming something outside the seven: `"null"`,
    // `"boolean"`, `"object"`, `"array"`, `"number"`, `"string"`,
    // `"integer"`.
    SchUnknownType
    // A `$ref` or `$dynamicRef` that is not a URI reference: it holds a
    // space, a control character or one of `"<>\\^`{|}`.
    SchBadRef
    // A `$ref` to a document the registry does not hold, or to a place
    // in a document that is not there.  A caller answers it by fetching
    // the document and registering it, which `schcompile.external_refs`
    // makes possible before any compile runs.
    SchUnresolvedRef
    // A cycle of references and in-place applicators that returns to a
    // schema without moving into the instance, such as `{"$ref": "#"}`
    // as a whole schema, which would never finish validating.  A
    // recursive schema that goes through `properties` or `items` moves
    // into the instance at each step and is fine.
    SchRefCycle
    // Two schema resources claiming the same `$id`, or an `$id` with a
    // fragment, which 2020-12 section 8.2.1 forbids.
    SchBadId
    // An `$anchor` or `$dynamicAnchor` that is not a plain name, or two
    // with the same name in one resource.
    SchBadAnchor
    // A `pattern` or a `patternProperties` key that `std.regex` does not
    // compile.  `found` carries `regex.error`'s own reason.
    SchBadPattern
    // A `$vocabulary` entry naming a vocabulary this package does not
    // recognise, with the value `true`, which 2020-12 section 8.1.2
    // says must be refused rather than ignored.  An entry with `false`
    // is optional, and is not refused.
    SchUnsupportedVocabulary
    // A `$schema` naming a dialect other than 2020-12, or a default
    // dialect in the options that is not 2020-12.  2019-09 and draft-07
    // are close and not the same, so a schema read under the wrong one
    // changes meaning without changing shape.
    SchUnknownDialect
    // The schema nests deeper than `SchOptions.max_depth`.
    SchDepthLimit
    // A keyword 2020-12 does not define, where
    // `SchOptions.refuse_unknown_keywords` asks for a refusal.  JSON
    // Schema's own rule is that an unknown keyword is an annotation.
    SchUnknownKeyword

// A fault: what, where in the schema, and what the value was.
pub struct SchFault
    kind: SchFaultKind
    // An RFC 6901 JSON Pointer into the schema document where the fault
    // is, such as `/properties/age/type`.  `""` for the document as a
    // whole.
    schema_location: Str
    // The same place as a URI, when the schema resource has an `$id` or
    // was registered under one:
    // `https://example.com/s#/properties/age/type`.  Empty otherwise.
    absolute_location: Str
    // What was there, as JSON text: `3`, `[]`, or the `$ref` that did
    // not resolve.
    found: Str

// `SchFault` is an `Error`, so a `Result` holding one is reported by
// anything that reports errors.
impl Error for SchFault
    // `scherror.message` of the fault.
    fn message(self) -> Str
        message(self)

// A fault from its parts.
//
// ```novo
// use scherror
//
// fn main() [io]
//     let f = scherror.fault(SchUnknownType, "/type", "", "integerish")
//     println(f.schema_location)
// ```
pub fn fault(kind: SchFaultKind, schema_location: Str, absolute_location: Str,
             found: Str) -> SchFault []
    SchFault { kind: kind,
        schema_location: schema_location,
        absolute_location: absolute_location,
        found: found }

// The kind's name, in the spelling a message uses.
//
// Lower case with hyphens, `unresolved-ref` and
// `unsupported-vocabulary`, and stable across releases, because
// programs quote them.
//
// ```novo
// use scherror
//
// fn main() [io]
//     println(scherror.kind_name(SchBadPattern))
// ```
pub fn kind_name(kind: SchFaultKind) -> Str []
    match kind
        SchNotASchema            => "not-a-schema"
        SchBadKeywordValue       => "bad-keyword-value"
        SchUnknownType           => "unknown-type"
        SchBadRef                => "bad-ref"
        SchUnresolvedRef         => "unresolved-ref"
        SchRefCycle              => "ref-cycle"
        SchBadId                 => "bad-id"
        SchBadAnchor             => "bad-anchor"
        SchBadPattern            => "bad-pattern"
        SchUnsupportedVocabulary => "unsupported-vocabulary"
        SchUnknownDialect        => "unknown-dialect"
        SchDepthLimit            => "depth-limit"
        SchUnknownKeyword        => "unknown-keyword"

// One line about the fault: the kind's name, where, and what was
// there.
//
// ```novo
// use scherror
//
// fn main() [io]
//     let f = scherror.fault(SchNotASchema, "/items", "", "3")
//     println(scherror.message(f))   // not-a-schema at /items: 3
// ```
pub fn message(f: SchFault) -> Str []
    var at = f.schema_location
    if at == ""
        at = "the root"
    "${kind_name(f.kind)} at ${at}: ${f.found}"
