// schvocab.nv — which of JSON Schema 2020-12's vocabularies this
// package implements, and which keywords each one owns.
//
// A validator that implements most of JSON Schema is one nobody can
// trust a schema to, because a keyword it skips passes everything.  The
// scope is therefore data a program can read: `implemented_keywords`,
// `unimplemented_keywords`, `keyword_is_asserted`.
//
// The package asserts the core, applicator, validation and unevaluated
// vocabularies, and `format` when a caller asks it to.  The content and
// meta-data vocabularies are annotations by design (2020-12 sections
// 8.5 and 9): their keywords are collected as annotations and never
// asserted.  A schema is not checked against the 2020-12 meta-schema
// before it is used; a caller that wants that check registers the
// meta-schema and validates the schema as an instance.

// The dialect this package implements.
//
// 2019-09 and draft-07 are close to 2020-12 and not the same: `items`
// means different things in 2020-12 and in 2019-09.  A `$schema` naming
// another dialect is `SchUnknownDialect`.
pub const DIALECT_2020_12 = "https://json-schema.org/draft/2020-12/schema"

// One of 2020-12's vocabularies.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     println(schvocab.vocabulary_uri(SchVocabValidation))
// ```
pub enum SchVocabulary
    // `$id`, `$schema`, `$ref`, `$anchor`, `$dynamicRef`,
    // `$dynamicAnchor`, `$vocabulary`, `$comment`, `$defs`.
    SchVocabCore
    // `allOf`, `anyOf`, `oneOf`, `not`, `if`/`then`/`else`,
    // `dependentSchemas`, `prefixItems`, `items`, `contains`,
    // `properties`, `patternProperties`, `additionalProperties`,
    // `propertyNames`.
    SchVocabApplicator
    // `type`, `enum`, `const`, the six numeric keywords, the three
    // string keywords, the array keywords, the object keywords.
    SchVocabValidation
    // `unevaluatedItems`, `unevaluatedProperties`.
    SchVocabUnevaluated
    // `format`, collected as an annotation.
    SchVocabFormatAnnotation
    // `format`, asserted.  Only for the formats a `schformat` registry
    // knows; a format nobody knows stays an annotation, as 2020-12
    // section 7.2.1 says.
    SchVocabFormatAssertion
    // `contentEncoding`, `contentMediaType`, `contentSchema`.
    // Collected, never asserted.
    SchVocabContent
    // `title`, `description`, `default`, `deprecated`, `readOnly`,
    // `writeOnly`, `examples`.  Annotations by definition.
    SchVocabMetaData

// The vocabulary's URI, as a `$vocabulary` object spells it.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     println(schvocab.vocabulary_uri(SchVocabCore))
// ```
pub fn vocabulary_uri(v: SchVocabulary) -> Str []
    let base = "https://json-schema.org/draft/2020-12/vocab/"
    match v
        SchVocabCore             => base + "core"
        SchVocabApplicator       => base + "applicator"
        SchVocabValidation       => base + "validation"
        SchVocabUnevaluated      => base + "unevaluated"
        SchVocabFormatAnnotation => base + "format-annotation"
        SchVocabFormatAssertion  => base + "format-assertion"
        SchVocabContent          => base + "content"
        SchVocabMetaData         => base + "meta-data"

// The vocabulary a URI names, or `None`.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     match schvocab.vocabulary_named("https://json-schema.org/draft/2020-12/vocab/core")
//         Some(v) => println(schvocab.vocabulary_uri(v))
//         None    => println("not a 2020-12 vocabulary")
// ```
pub fn vocabulary_named(uri: Str) -> ?SchVocabulary []
    for v in all_vocabularies()
        if vocabulary_uri(v) == uri
            return Some(v)
    None

// Whether this package asserts the vocabulary, rather than collecting
// it as annotations.
//
// True for core, applicator, validation, unevaluated and
// format-assertion.  False for format-annotation, content and
// meta-data, which are annotation vocabularies by design.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     let asserted = schvocab.is_implemented(SchVocabApplicator)
//     println("${asserted}")
// ```
pub fn is_implemented(v: SchVocabulary) -> Bool []
    match v
        SchVocabCore            => true
        SchVocabApplicator      => true
        SchVocabValidation      => true
        SchVocabUnevaluated     => true
        SchVocabFormatAssertion => true
        _                       => false

// Whether the vocabulary is an annotation vocabulary in the
// specification itself.
//
// True for format-annotation, content and meta-data.  Every vocabulary
// is either implemented or annotation-only, never neither.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     let note = schvocab.is_annotation_only(SchVocabContent)
//     println("${note}")
// ```
pub fn is_annotation_only(v: SchVocabulary) -> Bool []
    not is_implemented(v)

// Every keyword this package asserts, in specification order.
//
// The keywords of the core, applicator, validation and unevaluated
// vocabularies.  `format` is not among them: it is an annotation unless
// a caller asks for assertion.
//
// ```novo
// use std.list
// use schvocab
//
// fn main() [io]
//     println("${list.len(schvocab.implemented_keywords())}")
// ```
pub fn implemented_keywords() -> [Str] []
    list.concat(list.concat(keywords_of(SchVocabCore), keywords_of(SchVocabApplicator)),
                list.concat(keywords_of(SchVocabValidation), keywords_of(SchVocabUnevaluated)))

// Every keyword 2020-12 defines that this package collects and does
// not assert.
//
// `contentEncoding`, `contentMediaType`, `contentSchema`, and the seven
// meta-data keywords.
//
// ```novo
// use std.list
// use schvocab
//
// fn main() [io]
//     println("${list.len(schvocab.unimplemented_keywords())}")
// ```
pub fn unimplemented_keywords() -> [Str] []
    list.concat(keywords_of(SchVocabContent), keywords_of(SchVocabMetaData))

// Which vocabulary owns a keyword, or `None` for one 2020-12 does not
// define.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     match schvocab.keyword_vocabulary("unevaluatedProperties")
//         Some(v) => println(schvocab.vocabulary_uri(v))
//         None    => println("not a 2020-12 keyword")
// ```
pub fn keyword_vocabulary(keyword: Str) -> ?SchVocabulary []
    for v in all_vocabularies()
        if list.contains(keywords_of(v), keyword)
            return Some(v)
    None

// Whether this package asserts a keyword by name.
//
// ```novo
// use schvocab
//
// fn main() [io]
//     let yes = schvocab.keyword_is_asserted("minLength")
//     println("${yes}")
// ```
pub fn keyword_is_asserted(keyword: Str) -> Bool []
    list.contains(implemented_keywords(), keyword)

// The seven values `type` may take.
//
// `type` may be one of them or an array of them.
//
// ```novo
// use std.list
// use schvocab
//
// fn main() [io]
//     println("${list.len(schvocab.type_names())}")
// ```
pub fn type_names() -> [Str] []
    ["null", "boolean", "object", "array", "number", "string", "integer"]

// Every vocabulary, in the specification's order.
fn all_vocabularies() -> [SchVocabulary]
    [SchVocabCore, SchVocabApplicator, SchVocabUnevaluated, SchVocabValidation, SchVocabMetaData,
     SchVocabFormatAnnotation, SchVocabFormatAssertion, SchVocabContent]

// The keywords a vocabulary owns, in the specification's order.  The
// two format vocabularies own the one keyword `format`.
fn keywords_of(v: SchVocabulary) -> [Str]
    match v
        SchVocabCore        =>
            ["\$id", "\$schema", "\$ref", "\$anchor", "\$dynamicRef", "\$dynamicAnchor", "\$vocabulary", "\$comment",
             "\$defs"]
        SchVocabApplicator  =>
            ["prefixItems", "items", "contains", "additionalProperties", "properties", "patternProperties",
             "dependentSchemas", "propertyNames", "if", "then", "else", "allOf", "anyOf", "oneOf", "not"]
        SchVocabUnevaluated =>
            ["unevaluatedItems", "unevaluatedProperties"]
        SchVocabValidation  =>
            ["type", "enum", "const", "multipleOf", "maximum", "exclusiveMaximum", "minimum",
             "exclusiveMinimum", "maxLength", "minLength", "pattern", "maxItems", "minItems", "uniqueItems",
             "maxContains", "minContains", "maxProperties", "minProperties", "required", "dependentRequired"]
        SchVocabMetaData    =>
            ["title", "description", "default", "deprecated", "readOnly", "writeOnly", "examples"]
        SchVocabContent     =>
            ["contentEncoding", "contentMediaType", "contentSchema"]
        _                   =>
            ["format"]
