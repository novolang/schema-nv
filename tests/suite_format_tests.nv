month", "1998-13-01", false), ("2021 is not a leap year", "2021-02-29", false), ("2020 is a leap year", "2020-02-29", true), ("invalid non-ASCII '৪' (a Bengali 4)", "1963-06-1৪", false), ("invalid: non-ASCII Bengali digit in month field", "2020-0৪-01", false), ("ISO8601 / non-RFC3339: YYYYMMDD without dashes (2023-03-28)", "20230328", false), ("ISO8601 / non-RFC3339: week number implicit day of week (2023-01-02)", "2023-W01", false), ("ISO8601 / non-RFC3339: week number with day of week (2023-03-28)", "2023-W13-2", false), ("ISO8601 / non-RFC3339: week number rollover to next year (2023-01-01)", "2022W527", false), ("an invalid time string in date-time format", "2020-11-28T23:55:45Z", false), ("century year 0100 is not a leap year", "0100-02-29", false), ("century year 0400 is a leap year", "0400-02-29", true), ("century year 2100 is not a leap year", "2100-02-29", false), ("invalid: leading whitespace is not permitted", " 2024-01-15", false), ("invalid: trailing whitespace is not permitted", "2024-01-15 ", false), ("invalid: month 00 is not valid per date-month range 01-12", "2024-00-15", false), ("invalid: day 00 is not valid per date-mday minimum of 01", "2024-01-00", false), ("invalid: empty string", "", false), ("invalid: embedded whitespace between year and month", "2020 -01-01", false), ("invalid: trailing character after valid full-date", "2020-01-01X", false), ("invalid: trailing Z after full-date", "2020-01-01Z", false), ("invalid: full-date followed by space and time component", "2020-01-01 00:00:00Z", false), ("valid: four-digit year 0001", "0001-01-01", true), ("invalid: two-digit year (N-2 digits)", "20-01-01", false), ("invalid: three-digit year (N-1 digits)", "998-01-01", false), ("invalid: five-digit year (N+1 digits)", "12020-01-01", false), ("invalid: positive sign prefix on year", "+2020-01-01", false), ("invalid: negative sign prefix on year", "-2020-01-01", false), ("invalid: non-ASCII Bengali digit in year field", "২020-01-01", false), ("invalid: alphabetic characters in year field", "YYYY-01-01", false), ("invalid: three-digit month (N+1 digits)", "2020-001-01", false), ("invalid: alphabetic characters in month field", "2020-MM-01", false), ("invalid: three-digit day (N+1 digits)", "2020-01-001", false), ("invalid: alphabetic characters in day field", "2020-01-DD", false), ("invalid: colon separators", "2020:01:01", false), ("invalid: dot separators", "2020.01.01", false), ("invalid: space separators", "2020 01 01", false), ("invalid: mixed slash and hyphen separators", "2020-01/01", false), ("invalid: duplicated first hyphen", "2020--01-01", false), ("invalid: duplicated second hyphen", "2020-01--01", false), ("valid: date inside the Julian to Gregorian reform gap", "1582-10-10", true), ("invalid: year field numerically larger than a 32-bit signed integer",
