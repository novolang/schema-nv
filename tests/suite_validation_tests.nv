        ("exact length is valid", "[1]", true),
        ("too short is invalid", "[]", false),
        ("ignores non-arrays", "\"\"", true)])
    run("minItems: minItems validation with a decimal",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minItems\":1.0}",
        [("longer is valid", "[1,2]", true), ("too short is invalid", "[]", false)])

