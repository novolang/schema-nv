fn test_minLength() [io]
    run("minLength: minLength validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minLength\":2}", [("longer is valid", "\"foo\"", true),
        ("exact length is valid", "\"fo\"", true),
        ("too short is invalid", "\"f\"", false),
        ("ignores non-strings", "1", true),
        ("one grapheme is not long enough", "\"💩\"", false)])
    run("minLength: minLength validation with a decimal",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minLength\":2.0}",
        [("longer is valid", "\"foo\"", true), ("too short is invalid", "\"f\"", false)])

@test
fn test_minProperties() [io]
    run("minProperties: minProperties validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minProperties\":1}", [("longer is valid", "{\"foo\":1,\"bar\":2}", true),
        ("exact length is valid", "{\"foo\":1}", true),
        ("too short is invalid", "{}", false),
        ("ignores arrays", "[]", true),
        ("ignores strings", "\"\"", true),
        ("ignores other non-objects", "12", true),
        ("ignores null", "null", true),
        ("ignores booleans", "true", true)])
    run("minProperties: minProperties validation with a decimal",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minProperties\":1.0}",
        [("longer is valid", "{\"foo\":1,\"bar\":2}", true), ("too short is invalid", "{}", false)])

@test
fn test_multipleOf() [io]
    run("multipleOf: by int", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"multipleOf\":2}", [("int by int", "10", true),
        ("int by int fail", "7", false),
        ("ignores non-numbers", "\"foo\"", true)])
    run("multipleOf: by number", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"multipleOf\":1.5}", [("zero is multiple of anything", "0", true),
        ("4.5 is multiple of 1.5", "4.5", true),
        ("-4.5 is multiple of 1.5", "-4.5", true),
        ("35 is not multiple of 1.5", "35", false)])
    run("multipleOf: by small number", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"multipleOf\":0.0001}", [("0.0075 is multiple of 0.0001", "0.0075", true),
        ("0.00751 is not multiple of 0.0001", "0.00751", false)])
    run("multipleOf: float division = inf",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"integer\",\"multipleOf\":0.123456789}",
        [("always invalid, but naive implementations may raise an overflow error", "1e+308", false)])
    run("multipleOf: small multiple of large integer",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"integer\",\"multipleOf\":1e-08}",
        [("any integer is a multiple of 1e-8", "12391239123", true)])

@test
fn test_pattern() [io]
    run("pattern: pattern validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"pattern\":\"^a*\$\"}", [("a matching pattern is valid", "\"aaa\"", true),
        ("a non-matching pattern is invalid", "\"abc\"", false),
        ("ignores booleans", "true", true),
        ("ignores integers", "123", true),
        ("ignores floats", "1.0", true),
        ("ignores objects", "{}", true),
        ("ignores arrays", "[]", true),
        ("ignores null", "null", true)])
    run("pattern: pattern is not anchored",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"pattern\":\"a+\"}",
        [("matches a substring", "\"xxaayy\"", true)])

@test
fn test_required() [io]
    run("required: required validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"foo\":{},\"bar\":{}},\"required\":[\"foo\"]}", [("present required property is valid", "{\"foo\":1}", true),
        ("non-present required property is invalid", "{\"bar\":1}", false),
        ("ignores arrays", "[]", true),
        ("ignores strings", "\"\"", true),
        ("ignores other non-objects", "12", true),
        ("ignores null", "null", true),
        ("ignores boolean", "true", true)])
    run("required: required default validation",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"foo\":{}}}",
        [("not required by default", "{}", true)])
    run("required: required with empty array",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"foo\":{}},\"required\":[]}",
        [("property not required", "{}", true)])
    run("required: required with escaped characters", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"required\":[\"foo\\nbar\",\"foo\\\"bar\",\"foo\\\\bar\",\"foo\\rbar\",\"foo\\tbar\",\"foo\\fbar\"]}", [("object with all properties present is valid",
        "{\"foo\\nbar\":1,\"foo\\\"bar\":1,\"foo\\\\bar\":1,\"foo\\rbar\":1,\"foo\\tbar\":1,\"foo\\fbar\":1}",
        true),
    ("object with some properties missing is invalid",
        "{\"foo\\nbar\":\"1\",\"foo\\\"bar\":\"1\"}",
        false)])
    run("required: required properties whose names are Javascript object property names", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"required\":[\"__proto__\",\"toString\",\"constructor\"]}", [("ignores arrays", "[]", true),
        ("ignores other non-objects", "12", true),
        ("none of the properties mentioned", "{}", false),
        ("__proto__ present", "{\"__proto__\":\"foo\"}", false),
        ("toString present", "{\"toString\":{\"length\":37}}", false),
        ("constructor present", "{\"constructor\":{\"length\":37}}", false),
        ("all present", "{\"__proto__\":12,\"toString\":{\"length\":\"foo\"},\"constructor\":37}", true)])

@test
fn test_type() [io]
    run("type: integer type matches integers", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"integer\"}", [("an integer is an integer", "1", true),
        ("a float with zero fractional part is an integer", "1.0", true),
        ("a float is not an integer", "1.1", false),
        ("a string is not an integer", "\"foo\"", false),
        ("a string is still not an integer, even if it looks like one", "\"1\"", false),
        ("an object is not an integer", "{}", false),
        ("an array is not an integer", "[]", false),
        ("a boolean is not an integer", "true", false),
        ("null is not an integer", "null", false)])
    run("type: number type matches numbers", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"number\"}", [("an integer is a number", "1", true),
        ("a float with zero fractional part is a number (and an integer)", "1.0", true),
        ("a float is a number", "1.1", true),
        ("a string is not a number", "\"foo\"", false),
        ("a string is still not a number, even if it looks like one", "\"1\"", false),
        ("an object is not a number", "{}", false),
        ("an array is not a number", "[]", false),
        ("a boolean is not a number", "true", false),
        ("null is not a number", "null", false)])
    run("type: string type matches strings", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"string\"}", [("1 is not a string", "1", false),
        ("a float is not a string", "1.1", false),
        ("a string is a string", "\"foo\"", true),
        ("a string is still a string, even if it looks like a number", "\"1\"", true),
        ("an empty string is still a string", "\"\"", true),
        ("an object is not a string", "{}", false),
        ("an array is not a string", "[]", false),
        ("a boolean is not a string", "true", false),
        ("null is not a string", "null", false)])
    run("type: object type matches objects", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\"}", [("an integer is not an object", "1", false),
        ("a float is not an object", "1.1", false),
        ("a string is not an object", "\"foo\"", false),
        ("an object is an object", "{}", true),
        ("an array is not an object", "[]", false),
        ("a boolean is not an object", "true", false),
        ("null is not an object", "null", false)])
    run("type: array type matches arrays", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"array\"}", [("an integer is not an array", "1", false),
        ("a float is not an array", "1.1", false),
        ("a string is not an array", "\"foo\"", false),
        ("an object is not an array", "{}", false),
        ("an array is an array", "[]", true),
        ("a boolean is not an array", "true", false),
        ("null is not an array", "null", false)])
    run("type: boolean type matches booleans", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"boolean\"}", [("an integer is not a boolean", "1", false),
        ("zero is not a boolean", "0", false),
        ("a float is not a boolean", "1.1", false),
        ("a string is not a boolean", "\"foo\"", false),
        ("an empty string is not a boolean", "\"\"", false),
        ("an object is not a boolean", "{}", false),
        ("an array is not a boolean", "[]", false),
        ("true is a boolean", "true", true),
        ("false is a boolean", "false", true),
        ("null is not a boolean", "null", false)])
    run("type: null type matches only the null object", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"null\"}", [("an integer is not null", "1", false),
        ("a float is not null", "1.1", false),
        ("zero is not null", "0", false),
        ("a string is not null", "\"foo\"", false),
        ("an empty string is not null", "\"\"", false),
        ("an object is not null", "{}", false),
        ("an array is not null", "[]", false),
        ("true is not null", "true", false),
        ("false is not null", "false", false),
        ("null is null", "null", true)])
    run("type: multiple types can be specified in an array", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":[\"integer\",\"string\"]}", [("an integer is valid", "1", true),
        ("a string is valid", "\"foo\"", true),
        ("a float is invalid", "1.1", false),
        ("an object is invalid", "{}", false),
        ("an array is invalid", "[]", false),
        ("a boolean is invalid", "true", false),
        ("null is invalid", "null", false)])
    run("type: type as array with one item",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":[\"string\"]}",
        [("string is valid", "\"foo\"", true), ("number is invalid", "123", false)])
    run("type: type: array or object", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":[\"array\",\"object\"]}", [("array is valid", "[1,2,3]", true),
        ("object is valid", "{\"foo\":123}", true),
        ("number is invalid", "123", false),
        ("string is invalid", "\"foo\"", false),
        ("null is invalid", "null", false)])
    run("type: type: array, object or null", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":[\"array\",\"object\",\"null\"]}", [("array is valid", "[1,2,3]", true),
        ("object is valid", "{\"foo\":123}", true),
        ("null is valid", "null", true),
        ("number is invalid", "123", false),
        ("string is invalid", "\"foo\"", false)])

@test
fn test_uniqueItems() [io]
    run("uniqueItems: uniqueItems validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"uniqueItems\":true}", [("unique array of integers is valid", "[1,2]", true), ("non-unique array of integers is invalid", "[1,1]", false), ("non-unique array of more than two integers is invalid", "[1,2,1]", false), ("numbers are unique if mathematically unequal", "[1.0,1.0,1]", false), ("false is not equal to zero", "[0,false]", true), ("true is not equal to one", "[1,true]", true), ("unique array of strings is valid", "[\"foo\",\"bar\",\"baz\"]", true), ("non-unique array of strings is invalid", "[\"foo\",\"bar\",\"foo\"]", false), ("unique array of objects is valid", "[{\"foo\":\"bar\"},{\"foo\":\"baz\"}]", true), ("non-unique array of objects is invalid", "[{\"foo\":\"bar\"},{\"foo\":\"bar\"}]", false), ("property order of array of objects is ignored",
        "[{\"foo\":\"bar\",\"bar\":\"foo\"},{\"bar\":\"foo\",\"foo\":\"bar\"}]",
        false),
    ("unique array of nested objects is valid",
        "[{\"foo\":{\"bar\":{\"baz\":true}}},{\"foo\":{\"bar\":{\"baz\":false}}}]",
        true),
    ("non-unique array of nested objects is invalid",
        "[{\"foo\":{\"bar\":{\"baz\":true}}},{\"foo\":{\"bar\":{\"baz\":true}}}]",
        false),
    ("unique array of arrays is valid", "[[\"foo\"],[\"bar\"]]", true), ("non-unique array of arrays is invalid", "[[\"foo\"],[\"foo\"]]", false), ("non-unique array of more than two arrays is invalid",
        "[[\"foo\"],[\"bar\"],[\"foo\"]]",
        false),
    ("1 and true are unique", "[1,true]", true), ("0 and false are unique", "[0,false]", true), ("[1] and [true] are unique", "[[1],[true]]", true), ("[0] and [false] are unique", "[[0],[false]]", true), ("nested [1] and [true] are unique", "[[[1],\"foo\"],[[true],\"foo\"]]", true), ("nested [0] and [false] are unique", "[[[0],\"foo\"],[[false],\"foo\"]]", true), ("unique heterogeneous types are valid", "[{},[1],true,null,1,\"{}\"]", true), ("non-unique heterogeneous types are invalid", "[{},[1],true,null,{},1]", false), ("different objects are unique", "[{\"a\":1,\"b\":2},{\"a\":2,\"b\":1}]", true), ("objects are non-unique despite key order", "[{\"a\":1,\"b\":2},{\"b\":2,\"a\":1}]", false), ("{\"a\": false} and {\"a\": 0} are unique", "[{\"a\":false},{\"a\":0}]", true), ("{\"a\": true} and {\"a\": 1} are unique", "[{\"a\":true},{\"a\":1}]", true)])
    run("uniqueItems: uniqueItems with an array of items", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"prefixItems\":[{\"type\":\"boolean\"},{\"type\":\"boolean\"}],\"uniqueItems\":true}", [("[false, true] from items array is valid", "[false,true]", true), ("[true, false] from items array is valid", "[true,false]", true), ("[false, false] from items array is not valid", "[false,false]", false), ("[true, true] from items array is not valid", "[true,true]", false), ("unique array extended from [false, true] is valid", "[false,true,\"foo\",\"bar\"]", true), ("unique array extended from [true, false] is valid", "[true,false,\"foo\",\"bar\"]", true), ("non-unique array extended from [false, true] is not valid",
        "[false,true,\"foo\",\"foo\"]",
        false),
    ("non-unique array extended from [true, false] is not valid",
        "[true,false,\"foo\",\"foo\"]",
        false)])
    run("uniqueItems: uniqueItems with an array of items and additionalItems=false", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"prefixItems\":[{\"type\":\"boolean\"},{\"type\":\"boolean\"}],\"uniqueItems\":true,\"items\":false}", [("[false, true] from items array is valid", "[false,true]", true),
        ("[true, false] from items array is valid", "[true,false]", true),
        ("[false, false] from items array is not valid", "[false,false]", false),
        ("[true, true] from items array is not valid", "[true,true]", false),
        ("extra items are invalid even if unique", "[false,true,null]", false)])
    run("uniqueItems: uniqueItems=false validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"uniqueItems\":false}", [("unique array of integers is valid", "[1,2]", true), ("non-unique array of integers is valid", "[1,1]", true), ("numbers are unique if mathematically unequal", "[1.0,1.0,1]", true), ("false is not equal to zero", "[0,false]", true), ("true is not equal to one", "[1,true]", true), ("unique array of objects is valid", "[{\"foo\":\"bar\"},{\"foo\":\"baz\"}]", true), ("non-unique array of objects is valid", "[{\"foo\":\"bar\"},{\"foo\":\"bar\"}]", true), ("unique array of nested objects is valid",
        "[{\"foo\":{\"bar\":{\"baz\":true}}},{\"foo\":{\"bar\":{\"baz\":false}}}]",
        true),
    ("non-unique array of nested objects is valid",
        "[{\"foo\":{\"bar\":{\"baz\":true}}},{\"foo\":{\"bar\":{\"baz\":true}}}]",
        true),
    ("unique array of arrays is valid", "[[\"foo\"],[\"bar\"]]", true), ("non-unique array of arrays is valid", "[[\"foo\"],[\"foo\"]]", true), ("1 and true are unique", "[1,true]", true), ("0 and false are unique", "[0,false]", true), ("unique heterogeneous types are valid", "[{},[1],true,null,1]", true), ("non-unique heterogeneous types are valid", "[{},[1],true,null,{},1]", true)])
    run("uniqueItems: uniqueItems=false with an array of items", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"prefixItems\":[{\"type\":\"boolean\"},{\"type\":\"boolean\"}],\"uniqueItems\":false}", [("[false, true] from items array is valid", "[false,true]", true),
        ("[true, false] from items array is valid", "[true,false]", true),
        ("[false, false] from items array is valid", "[false,false]", true),
        ("[true, true] from items array is valid", "[true,true]", true),
        ("unique array extended from [false, true] is valid", "[false,true,\"foo\",\"bar\"]", true),
        ("unique array extended from [true, false] is valid", "[true,false,\"foo\",\"bar\"]", true),
        ("non-unique array extended from [false, true] is valid", "[false,true,\"foo\",\"foo\"]", true),
        ("non-unique array extended from [true, false] is valid", "[true,false,\"foo\",\"foo\"]", true)])
    run("uniqueItems: uniqueItems=false with an array of items and additionalItems=false", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"prefixItems\":[{\"type\":\"boolean\"},{\"type\":\"boolean\"}],\"uniqueItems\":false,\"items\":false}", [("[false, true] from items array is valid", "[false,true]", true),
        ("[true, false] from items array is valid", "[true,false]", true),
        ("[false, false] from items array is valid", "[false,false]", true),
        ("[true, true] from items array is valid", "[true,true]", true),
        ("extra items are invalid even if unique", "[false,true,null]", false)])
