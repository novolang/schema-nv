// Compile a group's schema against the remotes, then check that every
// instance gets the suite's answer from both the full validation and
// the fast path.
fn run(group: Str, schema: Str, cases: [(Str, Str, Bool)]) [io]
    let reg = remotes()
    match json.parse(schema)
        None    =>
            test.case(group)
            test.assert(false)
        Some(d) =>
            match schcompile.compile_with(d, reg)
                Err(f) =>
                    test.case(group + ": " + f.message())
                    test.assert(false)
                Ok(s)  =>
                    for (what, data, valid) in cases
                        test.case(group + ": " + what)
                        match json.parse(data)
                            None    =>
                                test.assert(false)
                            Some(i) =>
                                test.assert(schvalidate.validate(s, i).valid == valid)
                                test.assert(schvalidate.is_valid(s, i) == valid)

@test
fn test_const() [io]
    run("const: const validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":2}", [("same value is valid", "2", true),
        ("another value is invalid", "5", false),
        ("another type is invalid", "\"a\"", false)])
    run("const: const with object", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":{\"foo\":\"bar\",\"baz\":\"bax\"}}", [("same object is valid", "{\"foo\":\"bar\",\"baz\":\"bax\"}", true), ("same object with different property order is valid",
        "{\"baz\":\"bax\",\"foo\":\"bar\"}",
        true),
    ("another object is invalid", "{\"foo\":\"bar\"}", false), ("another type is invalid", "[1,2]", false)])
    run("const: const with array", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":[{\"foo\":\"bar\"}]}", [("same array is valid", "[{\"foo\":\"bar\"}]", true),
        ("another array item is invalid", "[2]", false),
        ("array with additional items is invalid", "[1,2,3]", false)])
    run("const: const with null",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":null}",
        [("null is valid", "null", true), ("not null is invalid", "0", false)])
    run("const: const with false does not match 0", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":false}", [("false is valid", "false", true),
        ("integer zero is invalid", "0", false),
        ("float zero is invalid", "0.0", false)])
    run("const: const with true does not match 1", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":true}", [("true is valid", "true", true),
        ("integer one is invalid", "1", false),
        ("float one is invalid", "1.0", false)])
    run("const: const with [false] does not match [0]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":[false]}", [("[false] is valid", "[false]", true),
        ("[0] is invalid", "[0]", false),
        ("[0.0] is invalid", "[0.0]", false)])
    run("const: const with [true] does not match [1]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":[true]}", [("[true] is valid", "[true]", true),
        ("[1] is invalid", "[1]", false),
        ("[1.0] is invalid", "[1.0]", false)])
    run("const: const with {\"a\": false} does not match {\"a\": 0}", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":{\"a\":false}}", [("{\"a\": false} is valid", "{\"a\":false}", true),
        ("{\"a\": 0} is invalid", "{\"a\":0}", false),
        ("{\"a\": 0.0} is invalid", "{\"a\":0.0}", false)])
    run("const: const with {\"a\": true} does not match {\"a\": 1}", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":{\"a\":true}}", [("{\"a\": true} is valid", "{\"a\":true}", true),
        ("{\"a\": 1} is invalid", "{\"a\":1}", false),
        ("{\"a\": 1.0} is invalid", "{\"a\":1.0}", false)])
    run("const: const with 0 does not match other zero-like types", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":0}", [("false is invalid", "false", false),
        ("integer zero is valid", "0", true),
        ("float zero is valid", "0.0", true),
        ("empty object is invalid", "{}", false),
        ("empty array is invalid", "[]", false),
        ("empty string is invalid", "\"\"", false)])
    run("const: const with 1 does not match true", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":1}", [("true is invalid", "true", false),
        ("integer one is valid", "1", true),
        ("float one is valid", "1.0", true)])
    run("const: const with -2.0 matches integer and float types", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":-2.0}", [("integer -2 is valid", "-2", true),
        ("integer 2 is invalid", "2", false),
        ("float -2.0 is valid", "-2.0", true),
        ("float 2.0 is invalid", "2.0", false),
        ("float -2.00001 is invalid", "-2.00001", false)])
    run("const: float and integers are equal up to 64-bit representation limits", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":9007199254740992}", [("integer is valid", "9007199254740992", true),
        ("integer minus one is invalid", "9007199254740991", false),
        ("float is valid", "9007199254740992.0", true),
        ("float minus one is invalid", "9007199254740991.0", false)])
    run("const: nul characters in strings", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":\"hello\\u0000there\"}", [("match string with nul", "\"hello\\u0000there\"", true),
        ("do not match string lacking nul", "\"hellothere\"", false)])
    run("const: characters with the same visual representation but different codepoint", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":\"μ\",\"\$comment\":\"U+03BC\"}", [("character uses the same codepoint", "\"μ\"", true),
        ("character looks the same but uses a different codepoint", "\"µ\"", false)])
    run("const: characters with the same visual representation, but different number of codepoints", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"const\":\"ä\",\"\$comment\":\"U+00E4\"}", [("character uses the same codepoint", "\"ä\"", true),
        ("character looks the same but uses combining marks", "\"ä\"", false)])

@test
fn test_dependentRequired() [io]
    run("dependentRequired: single dependency", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"dependentRequired\":{\"bar\":[\"foo\"]}}", [("neither", "{}", true),
        ("nondependant", "{\"foo\":1}", true),
        ("with dependency", "{\"foo\":1,\"bar\":2}", true),
        ("missing dependency", "{\"bar\":2}", false),
        ("ignores arrays", "[\"bar\"]", true),
        ("ignores strings", "\"foobar\"", true),
        ("ignores other non-objects", "12", true)])
    run("dependentRequired: empty dependents", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"dependentRequired\":{\"bar\":[]}}", [("empty object", "{}", true),
        ("object with one property", "{\"bar\":2}", true),
        ("non-object is valid", "1", true)])
    run("dependentRequired: multiple dependents required", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"dependentRequired\":{\"quux\":[\"foo\",\"bar\"]}}", [("neither", "{}", true),
        ("nondependants", "{\"foo\":1,\"bar\":2}", true),
        ("with dependencies", "{\"foo\":1,\"bar\":2,\"quux\":3}", true),
        ("missing dependency", "{\"foo\":1,\"quux\":2}", false),
        ("missing other dependency", "{\"bar\":1,\"quux\":2}", false),
        ("missing both dependencies", "{\"quux\":1}", false)])
    run("dependentRequired: dependencies with escaped characters", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"dependentRequired\":{\"foo\\nbar\":[\"foo\\rbar\"],\"foo\\\"bar\":[\"foo'bar\"]}}", [("CRLF", "{\"foo\\nbar\":1,\"foo\\rbar\":2}", true),
        ("quoted quotes", "{\"foo'bar\":1,\"foo\\\"bar\":2}", true),
        ("CRLF missing dependent", "{\"foo\\nbar\":1,\"foo\":2}", false),
        ("quoted quotes missing dependent", "{\"foo\\\"bar\":2}", false)])

@test
fn test_enum() [io]
    run("enum: simple enum validation",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[1,2,3]}",
        [("one of the enum is valid", "1", true), ("something else is invalid", "4", false)])
    run("enum: heterogeneous enum validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[6,\"foo\",[],true,{\"foo\":12}]}", [("one of the enum is valid", "[]", true),
        ("something else is invalid", "null", false),
        ("objects are deep compared", "{\"foo\":false}", false),
        ("valid object matches", "{\"foo\":12}", true),
        ("extra properties in object is invalid", "{\"foo\":12,\"boo\":42}", false)])
    run("enum: heterogeneous enum-with-null validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[6,null]}", [("null is valid", "null", true),
        ("number is valid", "6", true),
        ("something else is invalid", "\"test\"", false)])
    run("enum: enums in properties", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"foo\":{\"enum\":[\"foo\"]},\"bar\":{\"enum\":[\"bar\"]}},\"required\":[\"bar\"]}", [("both properties are valid", "{\"foo\":\"foo\",\"bar\":\"bar\"}", true),
        ("wrong foo value", "{\"foo\":\"foot\",\"bar\":\"bar\"}", false),
        ("wrong bar value", "{\"foo\":\"foo\",\"bar\":\"bart\"}", false),
        ("missing optional property is valid", "{\"bar\":\"bar\"}", true),
        ("missing required property is invalid", "{\"foo\":\"foo\"}", false),
        ("missing all properties is invalid", "{}", false)])
    run("enum: enum with escaped characters", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[\"foo\\nbar\",\"foo\\rbar\"]}", [("member 1 is valid", "\"foo\\nbar\"", true),
        ("member 2 is valid", "\"foo\\rbar\"", true),
        ("another string is invalid", "\"abc\"", false)])
    run("enum: enum with false does not match 0", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[false]}", [("false is valid", "false", true),
        ("integer zero is invalid", "0", false),
        ("float zero is invalid", "0.0", false)])
    run("enum: enum with [false] does not match [0]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[[false]]}", [("[false] is valid", "[false]", true),
        ("[0] is invalid", "[0]", false),
        ("[0.0] is invalid", "[0.0]", false)])
    run("enum: enum with true does not match 1", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[true]}", [("true is valid", "true", true),
        ("integer one is invalid", "1", false),
        ("float one is invalid", "1.0", false)])
    run("enum: enum with [true] does not match [1]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[[true]]}", [("[true] is valid", "[true]", true),
        ("[1] is invalid", "[1]", false),
        ("[1.0] is invalid", "[1.0]", false)])
    run("enum: enum with 0 does not match false", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[0]}", [("false is invalid", "false", false),
        ("integer zero is valid", "0", true),
        ("float zero is valid", "0.0", true)])
    run("enum: enum with [0] does not match [false]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[[0]]}", [("[false] is invalid", "[false]", false),
        ("[0] is valid", "[0]", true),
        ("[0.0] is valid", "[0.0]", true)])
    run("enum: enum with 1 does not match true", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[1]}", [("true is invalid", "true", false),
        ("integer one is valid", "1", true),
        ("float one is valid", "1.0", true)])
    run("enum: enum with [1] does not match [true]", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[[1]]}", [("[true] is invalid", "[true]", false),
        ("[1] is valid", "[1]", true),
        ("[1.0] is valid", "[1.0]", true)])
    run("enum: nul characters in strings", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[\"hello\\u0000there\"]}", [("match string with nul", "\"hello\\u0000there\"", true),
        ("do not match string lacking nul", "\"hellothere\"", false)])
    run("enum: empty enum", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[]}", [("string is invalid", "\"foo\"", false),
        ("number is invalid", "42", false),
        ("null is invalid", "null", false),
        ("object is invalid", "{}", false),
        ("array is invalid", "[]", false),
        ("boolean is invalid", "false", false)])
    run("enum: characters with the same visual representation, but different number of codepoints", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"enum\":[\"ä\"],\"\$comment\":\"U+00E4\"}", [("character uses the same codepoint", "\"ä\"", true),
        ("character looks the same but uses combining marks", "\"ä\"", false)])

@test
fn test_exclusiveMaximum() [io]
    run("exclusiveMaximum: exclusiveMaximum validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"exclusiveMaximum\":3.0}", [("below the exclusiveMaximum is valid", "2.2", true),
        ("boundary point is invalid", "3.0", false),
        ("above the exclusiveMaximum is invalid", "3.5", false),
        ("ignores non-numbers", "\"x\"", true)])

@test
fn test_exclusiveMinimum() [io]
    run("exclusiveMinimum: exclusiveMinimum validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"exclusiveMinimum\":1.1}", [("above the exclusiveMinimum is valid", "1.2", true),
        ("boundary point is invalid", "1.1", false),
        ("below the exclusiveMinimum is invalid", "0.6", false),
        ("ignores non-numbers", "\"x\"", true)])

@test
fn test_maxContains() [io]
    run("maxContains: maxContains without contains is ignored", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxContains\":1}", [("one item valid against lone maxContains", "[1]", true),
        ("two items still valid against lone maxContains", "[1,2]", true)])
    run("maxContains: maxContains with contains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"maxContains\":1}", [("empty data", "[]", false),
        ("all elements match, valid maxContains", "[1]", true),
        ("all elements match, invalid maxContains", "[1,1]", false),
        ("some elements match, valid maxContains", "[1,2]", true),
        ("some elements match, invalid maxContains", "[1,2,1]", false)])
    run("maxContains: maxContains with contains, value with a decimal", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"maxContains\":1.0}", [("one element matches, valid maxContains", "[1]", true),
        ("too many elements match, invalid maxContains", "[1,1]", false)])
    run("maxContains: minContains < maxContains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":1,\"maxContains\":3}", [("actual < minContains < maxContains", "[]", false),
        ("minContains < actual < maxContains", "[1,1]", true),
        ("minContains < maxContains < actual", "[1,1,1,1]", false)])
    run("maxContains: maxContains = 0 with minContains = 0",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":0,\"maxContains\":0}",
        [("empty array", "[]", true), ("one matching item", "[1]", false)])

@test
fn test_maximum() [io]
    run("maximum: maximum validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maximum\":3.0}", [("below the maximum is valid", "2.6", true),
        ("boundary point is valid", "3.0", true),
        ("above the maximum is invalid", "3.5", false),
        ("ignores non-numbers", "\"x\"", true)])
    run("maximum: maximum validation with unsigned integer", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maximum\":300}", [("below the maximum is valid", "299.97", true),
        ("boundary point integer is valid", "300", true),
        ("boundary point float is valid", "300.0", true),
        ("above the maximum is invalid", "300.5", false)])

@test
fn test_maxItems() [io]
    run("maxItems: maxItems validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxItems\":2}", [("shorter is valid", "[1]", true),
        ("exact length is valid", "[1,2]", true),
        ("too long is invalid", "[1,2,3]", false),
        ("ignores non-arrays", "\"foobar\"", true)])
    run("maxItems: maxItems validation with a decimal",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxItems\":2.0}",
        [("shorter is valid", "[1]", true), ("too long is invalid", "[1,2,3]", false)])

@test
fn test_maxLength() [io]
    run("maxLength: maxLength validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxLength\":2}", [("shorter is valid", "\"f\"", true),
        ("exact length is valid", "\"fo\"", true),
        ("too long is invalid", "\"foo\"", false),
        ("ignores non-strings", "100", true),
        ("two graphemes is long enough", "\"💩💩\"", true)])
    run("maxLength: maxLength validation with a decimal",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxLength\":2.0}",
        [("shorter is valid", "\"f\"", true), ("too long is invalid", "\"foo\"", false)])

@test
fn test_maxProperties() [io]
    run("maxProperties: maxProperties validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxProperties\":2}", [("shorter is valid", "{\"foo\":1}", true),
        ("exact length is valid", "{\"foo\":1,\"bar\":2}", true),
        ("too long is invalid", "{\"foo\":1,\"bar\":2,\"baz\":3}", false),
        ("ignores arrays", "[1,2,3]", true),
        ("ignores strings", "\"foobar\"", true),
        ("ignores other non-objects", "12", true)])
    run("maxProperties: maxProperties validation with a decimal", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxProperties\":2.0}", [("shorter is valid", "{\"foo\":1}", true),
        ("too long is invalid", "{\"foo\":1,\"bar\":2,\"baz\":3}", false)])
    run("maxProperties: maxProperties = 0 means the object is empty",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"maxProperties\":0}",
        [("no properties is valid", "{}", true), ("one property is invalid", "{\"foo\":1}", false)])

@test
fn test_minContains() [io]
    run("minContains: minContains without contains is ignored", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minContains\":1}", [("one item valid against lone minContains", "[1]", true),
        ("zero items still valid against lone minContains", "[]", true)])
    run("minContains: minContains=1 with contains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":1}", [("empty data", "[]", false),
        ("no elements match", "[2]", false),
        ("single element matches, valid minContains", "[1]", true),
        ("some elements match, valid minContains", "[1,2]", true),
        ("all elements match, valid minContains", "[1,1]", true)])
    run("minContains: minContains=2 with contains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":2}", [("empty data", "[]", false),
        ("all elements match, invalid minContains", "[1]", false),
        ("some elements match, invalid minContains", "[1,2]", false),
        ("all elements match, valid minContains (exactly as needed)", "[1,1]", true),
        ("all elements match, valid minContains (more than needed)", "[1,1,1]", true),
        ("some elements match, valid minContains", "[1,2,1]", true)])
    run("minContains: minContains=2 with contains with a decimal value", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":2.0}", [("one element matches, invalid minContains", "[1]", false),
        ("both elements match, valid minContains", "[1,1]", true)])
    run("minContains: maxContains = minContains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"maxContains\":2,\"minContains\":2}", [("empty data", "[]", false),
        ("all elements match, invalid minContains", "[1]", false),
        ("all elements match, invalid maxContains", "[1,1,1]", false),
        ("all elements match, valid maxContains and minContains", "[1,1]", true)])
    run("minContains: maxContains < minContains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"maxContains\":1,\"minContains\":3}", [("empty data", "[]", false),
        ("invalid minContains", "[1]", false),
        ("invalid maxContains", "[1,1,1]", false),
        ("invalid maxContains and minContains", "[1,1]", false)])
    run("minContains: minContains = 0",
        "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":0}",
        [("empty data", "[]", true), ("minContains = 0 makes contains always pass", "[2]", true)])
    run("minContains: minContains = 0 with maxContains", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contains\":{\"const\":1},\"minContains\":0,\"maxContains\":1}", [("empty data", "[]", true),
        ("not more than maxContains", "[1]", true),
        ("too many", "[1,1]", false)])

@test
fn test_minimum() [io]
    run("minimum: minimum validation", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minimum\":1.1}", [("above the minimum is valid", "2.6", true),
        ("boundary point is valid", "1.1", true),
        ("below the minimum is invalid", "0.6", false),
        ("ignores non-numbers", "\"x\"", true)])
    run("minimum: minimum validation with signed integer", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"minimum\":-2}", [("negative above the minimum is valid", "-1", true),
        ("positive above the minimum is valid", "0", true),
        ("boundary point is valid", "-2", true),
        ("boundary point with float is valid", "-2.0", true),
        ("float below the minimum is invalid", "-2.0001", false),
        ("int below the minimum is invalid", "-3", false),
        ("ignores non-numbers", "\"x\"", true)])

