// Compile a group's schema against the remotes, then check that every
// instance gets the suite's answer from both the full validation and
// the fast path.
fn run(group: Str, schema: Str, cases: [(Str, Str, Bool)]) [io]
    let reg = remotes()
    match json.parse(schema)
        None    =>
            test.case(group)
            test.assert(false)
        Some(d) =>
            match schcompile.compile_with(d, reg)
                Err(f) =>
                    test.case(group + ": " + f.message())
                    test.assert(false)
                Ok(s)  =>
                    for (what, data, valid) in cases
                        test.case(group + ": " + what)
                        match json.parse(data)
                            None    =>
                                test.assert(false)
                            Some(i) =>
                                test.assert(schvalidate.validate(s, i).valid == valid)
                                test.assert(schvalidate.is_valid(s, i) == valid)

@test
fn test_content() [io]
    run("content: validation of string-encoded content based on media type", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contentMediaType\":\"application/json\"}", [("a valid JSON document", "\"{\\\"foo\\\": \\\"bar\\\"}\"", true),
        ("an invalid JSON document; validates true", "\"{:}\"", true),
        ("ignores non-strings", "100", true)])
    run("content: validation of binary string-encoding", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contentEncoding\":\"base64\"}", [("a valid base64 string", "\"eyJmb28iOiAiYmFyIn0K\"", true), ("an invalid base64 string (% is not a valid character); validates true",
        "\"eyJmb28iOi%iYmFyIn0K\"",
        true),
    ("ignores non-strings", "100", true)])
    run("content: validation of binary-encoded media type documents", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contentMediaType\":\"application/json\",\"contentEncoding\":\"base64\"}", [("a valid base64-encoded JSON document", "\"eyJmb28iOiAiYmFyIn0K\"", true),
        ("a validly-encoded invalid JSON document; validates true", "\"ezp9Cg==\"", true),
        ("an invalid base64 string that is valid JSON; validates true", "\"{}\"", true),
        ("ignores non-strings", "100", true)])
    run("content: validation of binary-encoded media type documents with schema", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"contentMediaType\":\"application/json\",\"contentEncoding\":\"base64\",\"contentSchema\":{\"type\":\"object\",\"required\":[\"foo\"],\"properties\":{\"foo\":{\"type\":\"string\"}}}}", [("a valid base64-encoded JSON document", "\"eyJmb28iOiAiYmFyIn0K\"", true),
        ("another valid base64-encoded JSON document", "\"eyJib28iOiAyMCwgImZvbyI6ICJiYXoifQ==\"", true),
        ("an invalid base64-encoded JSON document; validates true", "\"eyJib28iOiAyMH0=\"", true),
        ("an empty object as a base64-encoded JSON document; validates true", "\"e30=\"", true),
        ("an empty array as a base64-encoded JSON document", "\"W10=\"", true),
        ("a validly-encoded invalid JSON document; validates true", "\"ezp9Cg==\"", true),
        ("an invalid base64 string that is valid JSON; validates true", "\"{}\"", true),
        ("ignores non-strings", "100", true)])

@test
fn test_default() [io]
    run("default: invalid type for default", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"foo\":{\"type\":\"integer\",\"default\":[]}}}", [("valid when property is specified", "{\"foo\":13}", true),
        ("still valid when the invalid default is used", "{}", true)])
    run("default: invalid string value for default", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"bar\":{\"type\":\"string\",\"minLength\":4,\"default\":\"bad\"}}}", [("valid when property is specified", "{\"bar\":\"good\"}", true),
        ("still valid when the invalid default is used", "{}", true)])
    run("default: the default keyword does not do anything if the property is missing", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"alpha\":{\"type\":\"number\",\"maximum\":3,\"default\":5}}}", [("an explicit property value is checked against maximum (passing)", "{\"alpha\":1}", true),
        ("an explicit property value is checked against maximum (failing)", "{\"alpha\":5}", false),
        ("missing properties are not filled in with the default", "{}", true)])

@test
fn test_format() [io]
    run("format: email format", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"format\":\"email\"}", [("all string formats ignore integers", "12", true),
        ("all string formats ignore floats", "13.7", true),
        ("all string formats ignore objects", "{}", true),
        ("all string formats ignore arrays", "[]", true),
        ("all string formats ignore booleans", "false", true),
        ("all string formats ignore nulls", "null", true),
        ("invalid email string is only an annotation by default", "\"2962\"", true)])
    run("format: idn-email format", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"format\":\"idn-email\"}", [("all string formats ignore integers", "12", true),
        ("all string formats ignore floats", "13.7", true),
