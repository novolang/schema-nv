    run("format: date-time format", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"format\":\"date-time\"}", [("all string formats ignore integers", "12", true), ("all string formats ignore floats", "13.7", true), ("all string formats ignore objects", "{}", true), ("all string formats ignore arrays", "[]", true), ("all string formats ignore booleans", "false", true), ("all string formats ignore nulls", "null", true), ("invalid date-time string is only an annotation by default",
        "\"1990-02-31T15:59:60.123-08:00\"",
