        "\"〮실례.테스트\"",
        true)])
    run("format: hostname format", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"format\":\"hostname\"}", [("all string formats ignore integers", "12", true), ("all string formats ignore floats", "13.7", true), ("all string formats ignore objects", "{}", true), ("all string formats ignore arrays", "[]", true), ("all string formats ignore booleans", "false", true), ("all string formats ignore nulls", "null", true), ("invalid hostname string is only an annotation by default",
        "\"-a-host-name-that-starts-with--\"",
        true)])
    run("format: date format", "{\"\$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"format\":\"date\"}", [("all string formats ignore integers", "12", true),
        ("all string formats ignore floats", "13.7", true),
        ("all string formats ignore objects", "{}", true),
        ("all string formats ignore arrays", "[]", true),
        ("all string formats ignore booleans", "false", true),
        ("all string formats ignore nulls", "null", true),
